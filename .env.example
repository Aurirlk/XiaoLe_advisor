# ============================================================
# 小乐AI · 高考志愿填报助手 — 环境变量配置
# ============================================================
# 复制为 .env 后填写（.env 不要提交到 GitHub）
# .config.yaml 中的 api_keys 优先读取此文件中的值
# 不用的供应商留空即可
# ============================================================

# ── LLM API Key ──────────────────────────────────────────
MIMO_API_KEY=tp-your-mimo-token-plan-key
DEEPSEEK_API_KEY=sk-your-key-here
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
DOUBAO_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
GROQ_API_KEY=

# ── ASR / TTS 通用（豆包/腾讯）──────────────────────────
# 硅基流动：TTS(CosyVoice) + Embedding(BGE-M3, v0.4.1 向量库默认 provider)
SILICONFLOW_API_KEY=
DOUBAO_APPID=
DOUBAO_ACCESS_TOKEN=
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ── ASR 专用（百度/讯飞）─────────────────────────────────
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# ── TTS 专用（阿里/MiniMax/FishSpeech）──────────────────
ALIYUN_APPKEY=
ALIYUN_TOKEN=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
MINIMAX_GROUP_ID=
FISH_SPEECH_API_KEY=

# ── 联网搜索 ─────────────────────────────────────────────
# DuckDuckGo 免费无需 Key，以下为可选付费搜索源
METASO_API_KEY=
TAVILY_API_KEY=

# ── Neo4j 图数据库 ──────────────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── 管理员 API Key（保护 admin/rag 写入端点）─────────────
ADMIN_API_KEY=
# 知乎 MCP 搜索 access secret（/api/zhihu/search 代理用；未配置时接口报错提示）
ZHIHU_ACCESS_SECRET=

# ── 数据库（不配置则使用 SQLite）────────────────────────
# POSTGRES_PASSWORD=your_password

# ── Redis / Celery ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# ── 服务端口 ─────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# UI_HOST=127.0.0.1
# UI_PORT=5000
# UI_API_BASE_URL=http://127.0.0.1:8000
# AUTO_OPEN_UI=1
# RELOAD=1

# ── 其他 ─────────────────────────────────────────────────
# HF_ENDPOINT=https://hf-mirror.com
# WEB_SEARCH_CACHE_TTL_HOURS=24
# WEB_SEARCH_ENABLE_FETCH=1
# CORS_ALLOW_ORIGINS=*

# ── 安全与合规（P0 整改新增）─────────────────────────────
# 生产环境必填；禁止明文默认值。开发环境缺省时自动生成进程级随机值。
JWT_SECRET=
# 手机号脱敏存储盐（生产必填；未配置时开发环境使用默认盐仅限本地）
PHONE_HASH_SALT=

# ── Checkpoint 后端（P0-8）───────────────────────────────
# memory（仅限开发/测试，生产禁止）/ sqlite / postgres（生产推荐）
# CHECKPOINT_BACKEND=memory
# postgres 连接串（CHECKPOINT_BACKEND=postgres 时必填）
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zx_advisor
# Checkpoint TTL 清理：>0 时每日清理超过 N 天的旧状态（0=关闭）
# CHECKPOINT_TTL_DAYS=30

# ── 接口防护（P0-10 / P0-11）─────────────────────────────
# 生产环境恒强制鉴权；开发环境默认放行，置 1 打开
# API_AUTH_REQUIRED=1
# WebSocket 最大并发连接数 / 空闲超时（秒）
# WS_MAX_CONN=200
# WS_IDLE_TIMEOUT_SECONDS=120
# 上传大小上限（MB）
# MAX_AUDIO_UPLOAD_MB=10
# MAX_IMAGE_UPLOAD_MB=10
# MAX_DOC_UPLOAD_MB=20
# 高成本端点限流（每分钟；0=关闭）
# RATE_LIMIT_ASR=20
# RATE_LIMIT_TTS=60
# RATE_LIMIT_VISION=30
# RATE_LIMIT_HARNESS_UPLOAD=20


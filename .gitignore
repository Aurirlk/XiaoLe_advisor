# 下载地址见 README「数据下载」章节
# ══════════════════════════════════════════════════════════
# 数据库（百度网盘）
data/*.db
data/*.db-*
!data/seeds/*.db

# 本地模型（465MB，可从 HuggingFace 重新下载，见配置指南 HF_ENDPOINT）
data/models/

# 原始/爬取数据（百度网盘）
data/raw/
data/crawl_results/

# 向量库与 RAG 索引（可由 scripts/build_rag_index.py 重建）
data/vector_store/
data/neo4j/

# 评测临时产物
data/eval/

# 前端依赖与构建产物
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# 可选：体积较大的完整 RAG 索引（仓库内保留 data/seeds/ 即可重建）
# data/vector_store/zx_experience.json

# 操作系统
.DS_Store
Thumbs.db
desktop.ini


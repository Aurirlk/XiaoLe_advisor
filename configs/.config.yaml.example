# ============================================================
# 小乐AI · 高考志愿填报助手 — 用户配置
# ============================================================
# 只需修改 selected_module 选择模型，填写 API Key 即可。
# 预设详情在 llm_config.yaml / asr_config.yaml / tts_config.yaml / vllm_config.yaml 中。
# ============================================================

# ==================== 模块选择 ====================
selected_module:
  LLM: MiMo                   # 大模型
  ASR: MiMoASR                # 语音识别
  TTS: MiMoTTS                # 语音合成
  VLLM: glm-4v-flash          # 视觉大模型
  # ── 恢复默认时改回以下 ──
  # LLM: deepseek-v4-flash
  # ASR: FunASR
  # TTS: EdgeTTS

# ==================== API Key ====================
api_keys:
  # ── MiMo（测试阶段，Token Plan 赠送额度）──────────────
  MIMO_API_KEY: "tp-cvsae1bcv88xklfxlz5cdtyqoze46slesdpty3c6e4siq5tp"

  # ── 其他供应商 Key（按需填写）────────────────────────
  DEEPSEEK_API_KEY: "${DEEPSEEK_API_KEY}"
  DASHSCOPE_API_KEY: "${DASHSCOPE_API_KEY}"
  ZHIPU_API_KEY: "${ZHIPU_API_KEY}"
  DOUBAO_API_KEY: "${DOUBAO_API_KEY}"
  MOONSHOT_API_KEY: "${MOONSHOT_API_KEY}"
  OPENAI_API_KEY: "${OPENAI_API_KEY}"
  MINIMAX_API_KEY: "${MINIMAX_API_KEY}"
  GROQ_API_KEY: "${GROQ_API_KEY}"
  SILICONFLOW_API_KEY: "${SILICONFLOW_API_KEY}"
  DOUBAO_APPID: "${DOUBAO_APPID}"
  DOUBAO_ACCESS_TOKEN: "${DOUBAO_ACCESS_TOKEN}"
  TENCENT_APPID: "${TENCENT_APPID}"
  TENCENT_SECRET_ID: "${TENCENT_SECRET_ID}"
  TENCENT_SECRET_KEY: "${TENCENT_SECRET_KEY}"
  BAIDU_APP_ID: "${BAIDU_APP_ID}"
  BAIDU_API_KEY: "${BAIDU_API_KEY}"
  BAIDU_SECRET_KEY: "${BAIDU_SECRET_KEY}"
  XUNFEI_APP_ID: "${XUNFEI_APP_ID}"
  XUNFEI_API_KEY: "${XUNFEI_API_KEY}"
  XUNFEI_API_SECRET: "${XUNFEI_API_SECRET}"
  ALIYUN_APPKEY: "${ALIYUN_APPKEY}"
  ALIYUN_TOKEN: "${ALIYUN_TOKEN}"
  ALIYUN_ACCESS_KEY_ID: "${ALIYUN_ACCESS_KEY_ID}"
  ALIYUN_ACCESS_KEY_SECRET: "${ALIYUN_ACCESS_KEY_SECRET}"
  MINIMAX_GROUP_ID: "${MINIMAX_GROUP_ID}"
  FISH_SPEECH_API_KEY: "${FISH_SPEECH_API_KEY}"
  METASO_API_KEY: "${METASO_API_KEY}"
  TAVILY_API_KEY: "${TAVILY_API_KEY}"

# ==================== 大模型配置 ====================
LLM:
  # ── MiMo ─────────────────────────────────────────────
  MiMo:
    type: openai
    model_name: mimo-v2.5
    # 正式 API（取消注释启用）
    # base_url: https://api.xiaomimimo.com/v1/chat/completions
    # MiMo Token Plan 测试阶段
    base_url: https://token-plan-cn.xiaomimimo.com/v1
    api_key: "${MIMO_API_KEY}"
    description: "小米 MiMo v2.5"

  # ── DeepSeek V4 系列 ─────────────────────────────────
  DeepSeek:
    type: openai
    model_name: deepseek-v4-flash
    base_url: https://api.deepseek.com/v1
    api_key: "${DEEPSEEK_API_KEY}"
    description: "DeepSeek V4 Flash"

  DeepSeekPro:
    type: openai
    model_name: deepseek-v4-pro
    base_url: https://api.deepseek.com/v1
    api_key: "${DEEPSEEK_API_KEY}"
    description: "DeepSeek V4 Pro"

  DeepSeekR1:
    type: openai
    model_name: deepseek-r1
    base_url: https://api.deepseek.com/v1
    api_key: "${DEEPSEEK_API_KEY}"
    temperature: 0.0
    description: "DeepSeek-R1 深度推理"

  # ── 通义千问 3.7 系列 ────────────────────────────────
  QwenPlus:
    type: openai
    model_name: qwen3.7-plus
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    api_key: "${DASHSCOPE_API_KEY}"
    description: "通义千问 3.7 Plus"

  QwenMax:
    type: openai
    model_name: qwen3.7-max
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    api_key: "${DASHSCOPE_API_KEY}"
    description: "通义千问 3.7 Max"

  QwenFlash:
    type: openai
    model_name: qwen3.7-flash
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    api_key: "${DASHSCOPE_API_KEY}"
    description: "通义千问 3.7 Flash，免费"

  # ── 智谱 GLM 5.1 系列 ───────────────────────────────
  GLM51Flash:
    type: openai
    model_name: glm-5.1-flash
    base_url: https://open.bigmodel.cn/api/paas/v4/
    api_key: "${ZHIPU_API_KEY}"
    description: "智谱 GLM-5.1 Flash，免费"

  GLM51Pro:
    type: openai
    model_name: glm-5.1-pro
    base_url: https://open.bigmodel.cn/api/paas/v4/
    api_key: "${ZHIPU_API_KEY}"
    description: "智谱 GLM-5.1 Pro"

  # ── 豆包 Seed 2.0 系列 ──────────────────────────────
  DoubaoSeed:
    type: openai
    model_name: doubao-seed-2.0-pro
    base_url: https://ark.cn-beijing.volces.com/api/v3
    api_key: "${DOUBAO_API_KEY}"
    description: "豆包 Seed 2.0 Pro"

  # ── Kimi ─────────────────────────────────────────────
  Kimi:
    type: openai
    model_name: kimi-k2.6
    base_url: https://api.moonshot.cn/v1
    api_key: "${MOONSHOT_API_KEY}"
    description: "Kimi K2.6"

  # ── Ollama 本地 ──────────────────────────────────────
  LocalQwen:
    type: ollama
    model_name: qwen2.5:14b
    base_url: http://localhost:11434
    api_key: ollama
    description: "本地 Qwen2.5-14B，零成本离线"

# ==================== 语音识别配置 ====================
ASR:
  # ── MiMo ASR ─────────────────────────────────────────
  MiMoASR:
    type: mimo
    model: mimo-v2.5-asr
    # 正式 API（取消注释启用）
    # url: https://api.xiaomimimo.com/v1/audio/asr
    # MiMo Token Plan 测试阶段
    url: https://token-plan-cn.xiaomimimo.com/v1/audio/asr
    api_key: "${MIMO_API_KEY}"
    description: "小米 MiMo ASR v2.5"

  # ── FunASR 本地（免费）───────────────────────────────
  FunASR:
    type: fun_local
    model_dir: models/SenseVoiceSmall
    description: "本地 FunASR，免费"

  # ── 阿里百炼 Paraformer ─────────────────────────────
  AliyunBLStream:
    type: aliyunbl_stream
    api_key: "${DASHSCOPE_API_KEY}"
    model: paraformer-realtime-v2
    description: "阿里百炼 Paraformer 实时流式"

  # ── 豆包 ASR ────────────────────────────────────────
  DoubaoStream:
    type: doubao_stream
    appid: "${DOUBAO_APPID}"
    access_token: "${DOUBAO_ACCESS_TOKEN}"
    resource_id: volc.bigasr.sauc.duration
    description: "火山引擎豆包 ASR"

  # ── 腾讯 ASR ────────────────────────────────────────
  Tencent:
    type: tencent
    appid: "${TENCENT_APPID}"
    secret_id: "${TENCENT_SECRET_ID}"
    secret_key: "${TENCENT_SECRET_KEY}"
    description: "腾讯云 ASR"

  # ── 百度 ASR ────────────────────────────────────────
  Baidu:
    type: baidu
    app_id: "${BAIDU_APP_ID}"
    api_key: "${BAIDU_API_KEY}"
    secret_key: "${BAIDU_SECRET_KEY}"
    dev_pid: 1537
    description: "百度语音识别"

  # ── 通义千问 ASR ────────────────────────────────────
  Qwen3ASR:
    type: qwen3_asr_flash
    api_key: "${DASHSCOPE_API_KEY}"
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    model_name: qwen3-asr-flash
    description: "通义千问 Qwen3-ASR"

  # ── Sherpa 本地 ─────────────────────────────────────
  SherpaLocal:
    type: sherpa_onnx_local
    model_dir: models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
    model_type: sense_voice
    description: "Sherpa 本地离线"

# ==================== 语音合成配置 ====================
TTS:
  # ── MiMo TTS ─────────────────────────────────────────
  MiMoTTS:
    type: mimo
    model: mimo-v2.5-tts
    # 正式 API（取消注释启用）
    # url: https://api.xiaomimimo.com/v1/audio/speech
    # MiMo Token Plan 测试阶段
    url: https://token-plan-cn.xiaomimimo.com/v1/audio/speech
    api_key: "${MIMO_API_KEY}"
    voice: mimo-v2.5-tts
    description: "小米 MiMo TTS v2.5"

  # ── Edge TTS（免费）──────────────────────────────────
  EdgeTTS:
    type: edge
    voice: zh-CN-XiaoxiaoNeural
    description: "微软 Edge TTS，免费"

  # ── 硅基流动 CosyVoice ──────────────────────────────
  CosyVoice:
    type: siliconflow
    model: FunAudioLLM/CosyVoice2-0.5B
    voice: FunAudioLLM/CosyVoice2-0.5B:alex
    access_token: "${SILICONFLOW_API_KEY}"
    description: "硅基流动 CosyVoice"

  # ── 阿里云 CosyVoice 流式 ───────────────────────────
  AliyunStream:
    type: aliyun_stream
    appkey: "${ALIYUN_APPKEY}"
    token: "${ALIYUN_TOKEN}"
    voice: longxiaochun
    access_key_id: "${ALIYUN_ACCESS_KEY_ID}"
    access_key_secret: "${ALIYUN_ACCESS_KEY_SECRET}"
    host: nls-gateway-cn-beijing.aliyuncs.com
    description: "阿里云 CosyVoice 流式"

  # ── 豆包 TTS ────────────────────────────────────────
  DoubaoTTS:
    type: doubao
    api_url: https://openspeech.bytedance.com/api/v1/tts
    appid: "${DOUBAO_APPID}"
    access_token: "${DOUBAO_ACCESS_TOKEN}"
    voice: BV001_streaming
    cluster: volcano_tts
    speed_ratio: 1.0
    description: "火山引擎豆包 TTS"

  # ── MiniMax TTS ─────────────────────────────────────
  MiniMaxTTS:
    type: minimax_httpstream
    group_id: "${MINIMAX_GROUP_ID}"
    api_key: "${MINIMAX_API_KEY}"
    model: speech-01-turbo
    voice_id: female-shaonv
    description: "MiniMax TTS"

  # ── 腾讯 TTS ────────────────────────────────────────
  TencentTTS:
    type: tencent
    appid: "${TENCENT_APPID}"
    secret_id: "${TENCENT_SECRET_ID}"
    secret_key: "${TENCENT_SECRET_KEY}"
    region: ap-guangzhou
    voice: 101001
    description: "腾讯云 TTS"

# ==================== 视觉大模型配置 ====================
VLLM:
  GLM4VFlash:
    type: openai
    model_name: glm-4v-flash
    base_url: https://open.bigmodel.cn/api/paas/v4/
    api_key: "${ZHIPU_API_KEY}"
    description: "智谱 GLM-4V Flash，免费"

  QwenVLPlus:
    type: openai
    model_name: qwen-vl-plus
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    api_key: "${DASHSCOPE_API_KEY}"
    description: "通义千问 VL Plus"

  GPT4o:
    type: openai
    model_name: gpt-4o
    base_url: https://api.openai.com/v1
    api_key: "${OPENAI_API_KEY}"
    description: "GPT-4o，需海外网络"
